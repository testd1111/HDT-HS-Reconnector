<Window x:Class="HS_Reconnector.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HS_Reconnector.UI"
        Title="HDT-HS-Reconnector"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="780"
        Height="790"
        MinWidth="700"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#12161C"
        Foreground="#ECF1F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#1A2029" />
        <SolidColorBrush x:Key="CardBorder" Color="#283240" />
        <SolidColorBrush x:Key="ControlBg" Color="#141921" />
        <SolidColorBrush x:Key="ControlBorder" Color="#344152" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
        <SolidColorBrush x:Key="MutedText" Color="#93A0B2" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECF1F8" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#232B36" />
            <Setter Property="Foreground" Value="#ECF1F8" />
            <Setter Property="BorderBrush" Value="#364354" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3746" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2631" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateCheckButton" TargetType="Button">
            <Setter Property="Background" Value="#1C2430" />
            <Setter Property="Foreground" Value="#B4C0D0" />
            <Setter Property="BorderBrush" Value="#344152" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263344" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18202B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangSegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#B4C0D0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25303E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#1E73B8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E73B8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4CC2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2586D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#185C94" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#242C37" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#364252" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReconnectActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1A6E4B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3FD18B" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Default">
                                <Setter TargetName="Bd" Property="Background" Value="#1E73B8" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Default" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2586D4" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Default" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#185C94" />
                            </MultiTrigger>

                            <Trigger Property="Tag" Value="HdtReady">
                                <Setter TargetName="Bd" Property="Background" Value="#1A6E4B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3FD18B" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="HdtReady" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#21855B" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="HdtReady" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#15573C" />
                            </MultiTrigger>

                            <Trigger Property="Tag" Value="HdtPartial">
                                <Setter TargetName="Bd" Property="Background" Value="#7A5415" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0B642" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="HdtPartial" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#94671B" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="HdtPartial" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#61420F" />
                            </MultiTrigger>

                            <Trigger Property="Tag" Value="HdtUnavailable">
                                <Setter TargetName="Bd" Property="Background" Value="#6F252E" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E0626E" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="HdtUnavailable" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#882E39" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="HdtUnavailable" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#591D24" />
                            </MultiTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#242C37" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}" />
            <Setter Property="Foreground" Value="#ECF1F8" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CaretBrush" Value="#4CC2FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE4EE" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A2029" />
            <Setter Property="Foreground" Value="#ECF1F8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#283648" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E73B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ECF1F8" />
            <Setter Property="Background" Value="{StaticResource ControlBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource ControlBg}" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="#93A0B2" Data="M 0,0 L 4,4 L 8,0 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,5,28,5"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}" Background="#1A2029" BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#4B5D74" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#93A0B2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                Cursor="Hand">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2EAF4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="40" Height="40" CornerRadius="10" Background="#1C2530" BorderBrush="#4CC2FF" BorderThickness="1.5" Margin="0,0,12,0">
                <Grid>
                    <Path Width="22" Height="22" Stretch="Uniform" Fill="#FFC23A"
                          Data="M 11,1 L 3,13 L 9,13 L 7,23 L 19,10 L 13,10 Z" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="HeaderTitle" Text="HDT-HS-Reconnector" FontSize="17" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                    <Button x:Name="CheckUpdatesButton"
                            Style="{StaticResource UpdateCheckButton}"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Click="CheckUpdatesButton_Click">
                        <TextBlock Text="&#x21BB;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="13"
                                   LineHeight="15"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0" />
                    </Button>
                    <TextBlock x:Name="VersionText"
                               FontSize="12"
                               Foreground="#8E9DB2"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#141921" BorderBrush="#415268" BorderThickness="1" CornerRadius="7" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LangRuButton" Content="RU" Style="{StaticResource LangSegmentButton}" Click="LangRuButton_Click" />
                        <Button x:Name="LangEnButton" Content="EN" Style="{StaticResource LangSegmentButton}" Click="LangEnButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="ElevationBadge" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center" Background="#163024" BorderBrush="#2EA067" BorderThickness="1">
                    <TextBlock x:Name="ElevationBadgeText" Text="Administrator" FontSize="11.5" FontWeight="SemiBold" Foreground="#5BE09C" />
                </Border>
                <Button x:Name="ReconnectButton" Style="{StaticResource ReconnectActionButton}" Tag="HdtUnavailable" ToolTipService.ShowOnDisabled="True" MinWidth="168" Click="ReconnectButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform" Fill="#FFC23A" Margin="0,0,7,0"
                              Data="M 11,1 L 3,13 L 9,13 L 7,23 L 19,10 L 13,10 Z" />
                        <TextBlock x:Name="ReconnectButtonText" Text="Reconnect" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Elevation warning banner (hidden when elevated) -->
        <Border x:Name="ElevationWarningBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#341B1E" BorderBrush="#A63A46" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,10">
            <TextBlock x:Name="ElevationWarningText" TextWrapping="Wrap" Foreground="#FFB8C0" FontSize="12" />
        </Border>

        <!-- Status Card -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="14,11" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <Button x:Name="CheckHdtButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="11.5" Click="CheckHdtButton_Click" Content="Check HDT" />
                    <TextBlock x:Name="StatusCardTitle" VerticalAlignment="Center"
                               Text="HDT, Game &amp; Connection Status" FontSize="12.5" FontWeight="SemiBold" Foreground="#93A0B2" />
                </DockPanel>

                <!-- HDT Exe / Process status -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,10,4">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#5BE09C" Margin="0,0,8,0"
                          Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z" />
                    <TextBlock x:Name="LabelHdt" Text="HDT:" Foreground="#93A0B2" Margin="0,0,6,0" />
                    <TextBlock x:Name="ValueHdt" Text="Checking..." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                </StackPanel>

                <!-- HDT Bridge / Functions readiness -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,4">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#4CC2FF" Margin="0,0,8,0"
                          Data="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4A2,2 0 0,0 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20A2,2 0 0,0 4,22H7.8V20.5C7.8,19 9,17.8 10.5,17.8C12,17.8 13.2,19 13.2,20.5V22H17A2,2 0 0,0 19,20V16H20.5A2.5,2.5 0 0,0 23,13.5A2.5,2.5 0 0,0 20.5,11Z" />
                    <TextBlock x:Name="LabelHdtBridge" Text="HDT Functions:" Foreground="#93A0B2" Margin="0,0,6,0" />
                    <TextBlock x:Name="ValueHdtBridge" Text="Checking..." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                </StackPanel>

                <Separator Grid.Row="2" Grid.ColumnSpan="2" Background="#283240" Margin="0,4,0,6" />

                <!-- Hearthstone status -->
                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,2,10,6">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#4CC2FF" Margin="0,0,8,0"
                          Data="M6,6H18A4,4 0 0,1 22,10V14A4,4 0 0,1 18,18H16L14,15H10L8,18H6A4,4 0 0,1 2,14V10A4,4 0 0,1 6,6M7,9V11H5V13H7V15H9V13H11V11H9V9H7M15.5,10A1.5,1.5 0 0,0 14,11.5A1.5,1.5 0 0,0 15.5,13A1.5,1.5 0 0,0 17,11.5A1.5,1.5 0 0,0 15.5,10Z" />
                    <TextBlock x:Name="LabelGame" Text="Hearthstone:" Foreground="#93A0B2" Margin="0,0,6,0" />
                    <TextBlock x:Name="ValueGame" Text="Not Running" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Server endpoint -->
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,6">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#4CC2FF" Margin="0,0,8,0"
                          Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.79 4.21,10.21L9,15V16A2,2 0 0,0 11,18M17.9,17.39C17.64,16.58 16.9,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.78 20,8.65 20,12C20,14.08 19.2,15.97 17.9,17.39Z" />
                    <TextBlock x:Name="LabelEndpoint" Text="Game Server:" Foreground="#93A0B2" Margin="0,0,6,0" />
                    <TextBlock x:Name="ValueEndpoint" Text="Waiting for match..." FontWeight="SemiBold" />
                </StackPanel>

                <!-- TCP Socket -->
                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,2,10,0">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#FFC23A" Margin="0,0,8,0"
                          Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" />
                    <TextBlock x:Name="LabelTcp" Text="TCP Socket:" Foreground="#93A0B2" Margin="0,0,6,0" />
                    <TextBlock x:Name="ValueTcp" Text="No active connection" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Log file -->
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                    <Path Width="13" Height="13" Stretch="Uniform" Fill="#93A0B2" Margin="0,0,8,0"
                          Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                    <TextBlock x:Name="LabelLog" Text="Active Log:" Foreground="#93A0B2" Margin="0,0,6,0" />
                    <TextBlock x:Name="ValueLog" Text="Not attached yet" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl x:Name="MainTabs" Grid.Row="3">
            <!-- Tab 1: Reconnect & Overlay -->
            <TabItem x:Name="TabSettings">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Hotkey row -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptHotkeyLabel" Text="Global Hotkey" VerticalAlignment="Center" Foreground="#DCE4EE" />
                                <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                <Button x:Name="ResetHotkeyButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ResetHotkeyButton_Click" Content="Reset" />
                                <Button x:Name="ClearHotkeyButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Click="ClearHotkeyButton_Click" Content="Disable" />
                            </Grid>
                            <TextBlock x:Name="HotkeyErrorText"
                                       Visibility="Collapsed"
                                       Foreground="#FF9AA2"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="205,0,0,8" />

                            <!-- Cooldown slider -->
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptCooldownLabel" Text="Post-reconnect Cooldown" VerticalAlignment="Center" Foreground="#DCE4EE" />
                                <Slider x:Name="CooldownSlider" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="Sliders_ValueChanged" />
                                <TextBlock x:Name="CooldownValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4CC2FF" FontWeight="SemiBold" />
                            </Grid>

                            <!-- Timeout slider -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptTimeoutLabel" Text="Disconnect Timeout" VerticalAlignment="Center" Foreground="#DCE4EE" />
                                <Slider x:Name="TimeoutSlider" Grid.Column="1" Minimum="5" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="Sliders_ValueChanged" />
                                <TextBlock x:Name="TimeoutValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4CC2FF" FontWeight="SemiBold" />
                            </Grid>

                            <Separator Background="#283240" Margin="0,0,0,12" />

                            <!-- Overlay section -->
                            <CheckBox x:Name="EnableOverlayCheck" Content="Show floating in-game overlay button" />
                            <CheckBox x:Name="OverlayOnlyMatchCheck" Content="Show overlay only when match endpoint is active" />
                            <CheckBox x:Name="OverlayOnlyWhenFocusedCheck" Content="Show overlay only when Hearthstone is in focus" />
                            <CheckBox x:Name="MiniOverlayCheck" Content="Use compact overlay button" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
                            <CheckBox x:Name="LockOverlayCheck" Content="Lock overlay position (prevent right-drag)" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
                            <CheckBox x:Name="SnapOverlaysCheck" Content="Snap Ping and Reconnect overlays together" Checked="SnapOverlaysCheck_Changed" Unchecked="SnapOverlaysCheck_Changed" />
                            <CheckBox x:Name="HideHdtHighlightCheck" Content="Do not highlight reconnect button by HDT status" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" Margin="0,4,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptOpacityLabel" Text="Overlay Opacity" VerticalAlignment="Center" Foreground="#DCE4EE" />
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="15" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="Sliders_ValueChanged" />
                                <TextBlock x:Name="OpacityValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4CC2FF" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptBgOpacityLabel" Text="Background Opacity" VerticalAlignment="Center" Foreground="#DCE4EE" />
                                <Slider x:Name="BgOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="Sliders_ValueChanged" />
                                <TextBlock x:Name="BgOpacityValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4CC2FF" FontWeight="SemiBold" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptScaleLabel" Text="Overlay Scale" VerticalAlignment="Center" Foreground="#DCE4EE" />
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="30" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="Sliders_ValueChanged" />
                                <TextBlock x:Name="ScaleValueText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4CC2FF" FontWeight="SemiBold" />
                            </Grid>

                            <DockPanel Margin="0,4,0,0">
                                <Button x:Name="TestOverlayButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="TestOverlayButton_Click" Content="TEST" />
                                <TextBlock x:Name="OverlayWeightLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,8,0" />
                                <ComboBox x:Name="OverlayWeightCombo" DockPanel.Dock="Left" MinWidth="112" Margin="0,0,8,0" SelectionChanged="OverlayCheck_Changed">
                                    <ComboBoxItem x:Name="OverlayNormalItem" />
                                    <ComboBoxItem x:Name="OverlaySemiboldItem" />
                                    <ComboBoxItem x:Name="OverlayBoldItem" />
                                    <ComboBoxItem x:Name="OverlayExtraBoldItem" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ResetOverlayButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ResetOverlayButton_Click" Content="Reset Overlay Pos" />
                                    <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" Content="Save &amp; Apply" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: Application & Hearthstone Path -->
            <TabItem x:Name="TabBehavior">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,6,0,0">
                    <StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to system tray on window close" />
                        <CheckBox x:Name="MinimizeToTrayOnMinimizeCheck" Content="Minimize to system tray when minimizing window" />
                        <CheckBox x:Name="StartMinimizedCheck" Content="Start minimized to system tray" Margin="0,4,0,14" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OptLanguageLabel" Text="Interface Language" VerticalAlignment="Center" Foreground="#DCE4EE" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Padding="8,5" SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Tag="auto" Content="Auto (System)" />
                                <ComboBoxItem Tag="en" Content="English" />
                                <ComboBoxItem Tag="ru" Content="Русский" />
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="OptHsPathLabel" Text="Hearthstone Folder (auto if empty)" Foreground="#DCE4EE" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HsPathTextBox" Margin="0,0,8,0" />
                            <Button x:Name="BrowseHsButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="BrowseHsButton_Click" Content="Browse..." />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SaveBehaviorButton" Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" Content="Save &amp; Apply" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="TabNetwork">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NetworkHintText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#93A4B8" />
                            <CheckBox x:Name="NetworkEnabledCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkShowRegionCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkShowAddressCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkShowFailedChecksCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkHideZeroFailuresCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkCompactCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkLockedCheck" Checked="NetworkPreviewSettings_Changed" Unchecked="NetworkPreviewSettings_Changed" />
                            <CheckBox x:Name="NetworkSnapOverlaysCheck" Checked="SnapOverlaysCheck_Changed" Unchecked="SnapOverlaysCheck_Changed" />
                            <WrapPanel Margin="0,8,0,8">
                                <TextBlock x:Name="NetworkRegionLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="NetworkRegionCombo" MinWidth="150" Margin="0,0,20,0" SelectionChanged="NetworkPreviewSettings_Changed">
                                    <ComboBoxItem x:Name="NetworkAutoItem" Tag="Auto" />
                                    <ComboBoxItem Content="EU" Tag="EU" />
                                    <ComboBoxItem Content="US" Tag="US" />
                                    <ComboBoxItem Content="ASIA" Tag="ASIA" />
                                    <ComboBoxItem Content="CHINA" Tag="CHINA" />
                                </ComboBox>
                                <TextBlock x:Name="NetworkWeightLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="NetworkWeightCombo" MinWidth="130" SelectionChanged="NetworkPreviewSettings_Changed">
                                    <ComboBoxItem x:Name="NetworkNormalItem" />
                                    <ComboBoxItem x:Name="NetworkSemiboldItem" />
                                    <ComboBoxItem x:Name="NetworkBoldItem" />
                                    <ComboBoxItem x:Name="NetworkExtraBoldItem" />
                                </ComboBox>
                            </WrapPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetworkScaleLabel" VerticalAlignment="Center" />
                                <Slider x:Name="NetworkScaleSlider" Grid.Column="1" Minimum="30" Maximum="150" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,0" ValueChanged="NetworkSlider_Changed" />
                                <TextBlock x:Name="NetworkScaleValue" Grid.Column="2" Text="100%" Foreground="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetworkOpacityLabel" VerticalAlignment="Center" />
                                <Slider x:Name="NetworkOpacitySlider" Grid.Column="1" Minimum="15" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,0" ValueChanged="NetworkSlider_Changed" />
                                <TextBlock x:Name="NetworkOpacityValue" Grid.Column="2" Text="100%" Foreground="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetworkBackgroundOpacityLabel" VerticalAlignment="Center" />
                                <Slider x:Name="NetworkBackgroundOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,0" ValueChanged="NetworkSlider_Changed" />
                                <TextBlock x:Name="NetworkBackgroundOpacityValue" Grid.Column="2" Text="10%" Foreground="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="205" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetworkIntervalLabel" VerticalAlignment="Center" />
                                <Slider x:Name="NetworkIntervalSlider" Grid.Column="1" Minimum="2" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,10,0" ValueChanged="NetworkSlider_Changed" />
                                <TextBlock x:Name="NetworkIntervalValue" Grid.Column="2" Text="3s" Foreground="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <DockPanel Margin="0,4,0,0">
                                <Button x:Name="NetworkPreviewButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="NetworkPreview_Click" Content="TEST" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="NetworkResetPositionButton" Style="{StaticResource SecondaryButton}" Click="NetworkResetPosition_Click" Margin="0,0,8,0" />
                                    <Button x:Name="NetworkSaveButton" Style="{StaticResource PrimaryButton}" Click="NetworkSave_Click" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="TabOpponentMemory">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="OmHintText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#93A4B8" FontSize="12" />

                            <Border x:Name="OmOutdatedBanner" Visibility="Collapsed"
                                    Background="#342A16" BorderBrush="#C28D2D" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                                <TextBlock x:Name="OmOutdatedText" TextWrapping="Wrap" Foreground="#FFD88A" FontSize="11.5" />
                            </Border>

                            <CheckBox x:Name="OmEnabledCheck" Checked="OmControl_Changed" Unchecked="OmControl_Changed" />
                            <CheckBox x:Name="OmColorByResultCheck" Checked="OmControl_Changed" Unchecked="OmControl_Changed" Margin="0,2,0,10" />

                            <!-- Mode & Visual Style -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OmDisplayModeLabel" VerticalAlignment="Center" Foreground="#DCE4EE" Margin="0,0,10,0" />
                                    <ComboBox x:Name="OmDisplayModeCombo" Grid.Column="1" SelectionChanged="OmControl_Changed">
                                        <ComboBoxItem x:Name="OmModeDamageItem" Tag="Damage" />
                                        <ComboBoxItem x:Name="OmModeDotItem" Tag="Dot" />
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OmVisualStyleLabel" VerticalAlignment="Center" Foreground="#DCE4EE" Margin="0,0,10,0" />
                                    <ComboBox x:Name="OmVisualStyleCombo" Grid.Column="1" SelectionChanged="OmControl_Changed">
                                        <ComboBoxItem x:Name="OmStyleBadgeItem" Tag="Badge" />
                                        <ComboBoxItem x:Name="OmStyleOutlinedItem" Tag="Outlined" />
                                        <ComboBoxItem x:Name="OmStylePlainItem" Tag="Plain" />
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <!-- Colors (2x2) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="OmWinColorRow" Grid.Row="0" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OmWinColorLabel" VerticalAlignment="Center" Foreground="#DCE4EE" Margin="0,0,8,0" />
                                    <Button x:Name="OmWinSwatch" Grid.Column="1" Tag="Win" Style="{StaticResource ColorSwatchButton}" Margin="0,0,8,0" Click="OmColorSwatch_Click" />
                                    <TextBox x:Name="OmWinColorBox" Grid.Column="2" MaxLength="9" FontFamily="Consolas" FontSize="12" Padding="6,4" TextChanged="OmColorText_Changed" />
                                </Grid>

                                <Grid x:Name="OmLossColorRow" Grid.Row="0" Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OmLossColorLabel" VerticalAlignment="Center" Foreground="#DCE4EE" Margin="0,0,8,0" />
                                    <Button x:Name="OmLossSwatch" Grid.Column="1" Tag="Loss" Style="{StaticResource ColorSwatchButton}" Margin="0,0,8,0" Click="OmColorSwatch_Click" />
                                    <TextBox x:Name="OmLossColorBox" Grid.Column="2" MaxLength="9" FontFamily="Consolas" FontSize="12" Padding="6,4" TextChanged="OmColorText_Changed" />
                                </Grid>

                                <Grid x:Name="OmDrawColorRow" Grid.Row="2" Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OmDrawColorLabel" VerticalAlignment="Center" Foreground="#DCE4EE" Margin="0,0,8,0" />
                                    <Button x:Name="OmDrawSwatch" Grid.Column="1" Tag="Draw" Style="{StaticResource ColorSwatchButton}" Margin="0,0,8,0" Click="OmColorSwatch_Click" />
                                    <TextBox x:Name="OmDrawColorBox" Grid.Column="2" MaxLength="9" FontFamily="Consolas" FontSize="12" Padding="6,4" TextChanged="OmColorText_Changed" />
                                </Grid>

                                <Grid x:Name="OmNeutralColorRow" Grid.Row="2" Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OmNeutralColorLabel" VerticalAlignment="Center" Foreground="#DCE4EE" Margin="0,0,8,0" />
                                    <Button x:Name="OmNeutralSwatch" Grid.Column="1" Tag="Neutral" Style="{StaticResource ColorSwatchButton}" Margin="0,0,8,0" Click="OmColorSwatch_Click" />
                                    <TextBox x:Name="OmNeutralColorBox" Grid.Column="2" MaxLength="9" FontFamily="Consolas" FontSize="12" Padding="6,4" TextChanged="OmColorText_Changed" />
                                </Grid>
                            </Grid>

                            <!-- Sliders (2x2) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="OmScaleValue" DockPanel.Dock="Right" Foreground="#4CC2FF" FontWeight="SemiBold" Text="100%" />
                                        <TextBlock x:Name="OmScaleLabel" Foreground="#DCE4EE" />
                                    </DockPanel>
                                    <Slider x:Name="OmScaleSlider" Minimum="30" Maximum="180" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OmSlider_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="OmOpacityValue" DockPanel.Dock="Right" Foreground="#4CC2FF" FontWeight="SemiBold" Text="100%" />
                                        <TextBlock x:Name="OmOpacityLabel" Foreground="#DCE4EE" />
                                    </DockPanel>
                                    <Slider x:Name="OmOpacitySlider" Minimum="20" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OmSlider_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="OmOffsetXValue" DockPanel.Dock="Right" Foreground="#4CC2FF" FontWeight="SemiBold" Text="0 px" />
                                        <TextBlock x:Name="OmOffsetXLabel" Foreground="#DCE4EE" />
                                    </DockPanel>
                                    <Slider x:Name="OmOffsetXSlider" Minimum="-40" Maximum="40" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OmSlider_Changed" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="OmOffsetYValue" DockPanel.Dock="Right" Foreground="#4CC2FF" FontWeight="SemiBold" Text="0 px" />
                                        <TextBlock x:Name="OmOffsetYLabel" Foreground="#DCE4EE" />
                                    </DockPanel>
                                    <Slider x:Name="OmOffsetYSlider" Minimum="-40" Maximum="40" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OmSlider_Changed" />
                                </StackPanel>
                            </Grid>

                            <!-- Live Preview -->
                            <Border x:Name="OmPreviewPanel" Background="#11161D" BorderBrush="#283240" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock x:Name="OmPreviewLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#93A0B2" FontSize="12" Margin="0,0,18,0" />
                                    <StackPanel x:Name="OmPreviewItems" Orientation="Horizontal" VerticalAlignment="Center" MinHeight="38">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                            <Border x:Name="OmPreviewWinBadge" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:OutlinedTextBlock x:Name="OmPreviewWinText" Text="12" FontWeight="Bold" CenterVisualBounds="True" />
                                                    <Ellipse x:Name="OmPreviewWinDot" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="OmPreviewWinCaption" VerticalAlignment="Center" Foreground="#B4C0D0" FontSize="12" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                                            <Border x:Name="OmPreviewLossBadge" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:OutlinedTextBlock x:Name="OmPreviewLossText" Text="15" FontWeight="Bold" CenterVisualBounds="True" />
                                                    <Ellipse x:Name="OmPreviewLossDot" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="OmPreviewLossCaption" VerticalAlignment="Center" Foreground="#B4C0D0" FontSize="12" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="OmPreviewDrawBadge" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:OutlinedTextBlock x:Name="OmPreviewDrawText" Text="0" FontWeight="Bold" CenterVisualBounds="True" />
                                                    <Ellipse x:Name="OmPreviewDrawDot" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="OmPreviewDrawCaption" VerticalAlignment="Center" Foreground="#B4C0D0" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DockPanel Margin="0,2,0,0">
                                <Button x:Name="OmResetButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="OmResetButton_Click" />
                                <Button x:Name="OmSaveButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="OmSaveButton_Click" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="TabLogs">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,6,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="LogTextBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 VerticalContentAlignment="Top"
                                 Background="#10141A"
                                 BorderBrush="#252E3B"
                                 SelectionChanged="LogTextBox_SelectionChanged" />
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <CheckBox x:Name="VerboseLoggingCheck"
                                      DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Checked="VerboseLoggingCheck_Changed"
                                      Unchecked="VerboseLoggingCheck_Changed" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="OpenLogsFolderButton" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="OpenLogsFolderButton_Click" />
                                <Button x:Name="ClearLogButton" Style="{StaticResource SecondaryButton}"
                                        Click="ClearLogButton_Click" Content="Clear" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
